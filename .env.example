APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
L5_SWAGGER_CONST_HOST=http://localhost:8000
L5_SWAGGER_GENERATE_ALWAYS=false
TELESCOPE_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SANCTUM_TOKEN_EXPIRATION=1440
FRONTEND_URL=https://otantikqueen.com
# STAGING_FRONTEND_URL=
EASYPOST_QUOTE_TTL_MINUTES=15

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# ─── Visitor Analytics & Tracking ──────────────────────────────────────────────
ANALYTICS_ENABLED=true
ANALYTICS_GEOIP_ENABLED=true
ANALYTICS_IGNORE_BOTS=true

LOCATION_PROVIDER=geoapify
GEOAPIFY_API_KEY=

# ─── EasyPost Shipping ─────────────────────────────────────────────────────────
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=

# ─── Store Origin Address (for shipping labels) ───────────────────────────────
STORE_ADDRESS_NAME="My Store"
STORE_ADDRESS_STREET1="123 Main Street"
STORE_ADDRESS_CITY="New York"
STORE_ADDRESS_STATE="NY"
STORE_ADDRESS_ZIP="10001"
STORE_ADDRESS_COUNTRY="US"
STORE_ADDRESS_PHONE="+1234567890"
