APP_NAME=Laravel
APP_ENV=local
APP_VERSION=local
APP_DEPLOYED_AT=
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
L5_SWAGGER_CONST_HOST=http://localhost:8000
L5_SWAGGER_GENERATE_ALWAYS=false
TELESCOPE_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS) so the session/XSRF cookies are Secure.
SESSION_SECURE_COOKIE=false
# "lax" is correct for a frontend on a subdomain of the same registrable
# domain as the API (e.g. otantikqueen.com -> apis.otantikqueen.com). Only
# use "none" (which also requires SESSION_SECURE_COOKIE=true) if the SPA is
# served from a genuinely different site.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SANCTUM_TOKEN_EXPIRATION=1440
# Domains allowed to authenticate via stateful (httpOnly cookie) Sanctum
# sessions instead of Bearer tokens. Must match the web SPA's origin(s),
# without a scheme (e.g. "otantikqueen.com,apis.otantikqueen.com").
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000
FRONTEND_URL=https://otantikqueen.com
# STAGING_FRONTEND_URL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# ─── Visitor Analytics & Tracking ──────────────────────────────────────────────
ANALYTICS_ENABLED=true
ANALYTICS_GEOIP_ENABLED=true
ANALYTICS_IGNORE_BOTS=true

LOCATION_PROVIDER=geoapify
GEOAPIFY_API_KEY=

# ─── EasyPost Shipping ─────────────────────────────────────────────────────────
EASYPOST_DRIVER=easypost
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
EASYPOST_QUOTE_TTL_MINUTES=15

# ─── Stripe Payments ───────────────────────────────────────────────────────────
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_CHECKOUT_EXPIRES_MINUTES=30
STRIPE_MINIMUM_CHARGE=0.50

# ─── Google Sign-In & Places ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1

# ─── OTP (email/password-reset verification codes) ─────────────────────────────
# OTP_LENGTH=6
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_DAILY_SEND_LIMIT=5
# Route every OTP to this address instead of the real recipient (staging only).
# OTP_EMAIL_OVERRIDE=
# Never enable in production — logs the raw OTP code.
OTP_LOG_CODES=false

# ─── Store Origin Address (for shipping labels) ───────────────────────────────
STORE_ADDRESS_NAME="My Store"
STORE_ADDRESS_STREET1="123 Main Street"
STORE_ADDRESS_CITY="New York"
STORE_ADDRESS_STATE="NY"
STORE_ADDRESS_ZIP="10001"
STORE_ADDRESS_COUNTRY="US"
STORE_ADDRESS_PHONE="+1234567890"
